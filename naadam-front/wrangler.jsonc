{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "naadam-front",
  "main": "src/index.js",
  "compatibility_date": "2026-11-19",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ],
    "not_found_handling": "404-page"
  },
  "services": [
    {
      "binding": "API",
      "service": "naadam-api"
    }
  ],
  "observability": {
    "enabled": true
  }
}
