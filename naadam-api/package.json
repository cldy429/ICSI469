{
  "name": "naadam-api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "deploy": "wrangler deploy",
    "predeploy": "npm run db:migrate:remote",
    "dev": "npm run db:migrate && wrangler dev",
    "start": "npm run dev",
    "db:migrate": "wrangler d1 migrations apply naadam-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply naadam-db --remote",
    "db:count": "wrangler d1 execute naadam-db --local --command=\"SELECT COUNT(*) AS total_wrestlers FROM wrestlers\"",
    "test": "vitest run",
    "check": "wrangler deploy --dry-run --outdir .wrangler/check"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.3",
    "wrangler": "^4",
    "vitest": "~5.0.3"
  },
  "type": "module"
}
